      "dialogues": [
        {"speaker": "staff", "speakerName": "직원", "japanese": "パスポートと予約確認書をお願いします。", "korean": "여권과 예약확인서 부탁합니다."},
        {"speaker": "player", "speakerName": "학습자", "choices": [

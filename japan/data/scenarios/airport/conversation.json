        {"speaker": "staff", "speakerName": "직원", "japanese": "お席は窓側と通路側、どちらがよろしいですか？", "korean": "좌석은 창가와 통로측, 어느 쪽이 좋으세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "窓側をお願いします。", "korean": "창가로 부탁합니다.", "correct": true},
          {"japanese": "通路側でお願いします。", "korean": "통로측으로 부탁합니다.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "お預けになる荷物はございますか？", "korean": "맡기실 짐이 있으세요?", "tip": "お預けになる는 '맡기시다'의 존경어"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "はい、スーツケース一つです。", "korean": "네, 캐리어 하나입니다.", "correct": true},
          {"japanese": "いいえ、手荷物だけです。", "korean": "아니요, 기내 수하물만요.", "correct": true}
        ]}
      ]
    },
    {

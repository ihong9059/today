      "location": "보안검색대",
      "dialogues": [
        {"speaker": "staff", "speakerName": "보안요원", "japanese": "ノートパソコンとペットボトルは出してください。", "korean": "노트북과 페트병은 꺼내주세요."},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "はい、わかりました。", "korean": "네, 알겠습니다.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "보안요원", "japanese": "上着を脱いでください。", "korean": "겉옷을 벗어주세요."},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "はい。", "korean": "네.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "보안요원", "japanese": "はい、大丈夫です。お進みください。", "korean": "네, 괜찮습니다. 지나가세요."}
      ]
    },
    {
      "id": 3,
      "title": "입국심사",
      "location": "입국심사대",
      "dialogues": [
        {"speaker": "staff", "speakerName": "심사관", "japanese": "滞在の目的は何ですか？", "korean": "체류 목적이 뭔가요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "観光です。", "korean": "관광입니다.", "correct": true},
          {"japanese": "ビジネスです。", "korean": "비즈니스입니다.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "심사관", "japanese": "何日間滞在しますか？", "korean": "며칠간 체류하세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "5日間です。", "korean": "5일간입니다.", "correct": true},
          {"japanese": "一週間です。", "korean": "일주일입니다.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "심사관", "japanese": "どこに泊まりますか？", "korean": "어디에 묵으세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [

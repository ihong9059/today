{
  "title": "백화점 회화",
  "scenes": [
    {
      "id": 1,
      "title": "매장 찾기",
      "location": "백화점 1층",
      "dialogues": [
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "すみません、化粧品売り場はどこですか？", "korean": "저기요, 화장품 매장이 어디예요?", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "안내원", "japanese": "化粧品売り場は2階でございます。", "korean": "화장품 매장은 2층입니다."},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "エレベーターはどこですか？", "korean": "엘리베이터는 어디예요?", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "안내원", "japanese": "あちらの奥にございます。", "korean": "저쪽 안쪽에 있습니다."}
      ]
    },
    {
      "id": 2,
      "title": "상품 문의",
      "location": "화장품 매장",
      "dialogues": [
        {"speaker": "staff", "speakerName": "점원", "japanese": "いらっしゃいませ。何かお探しですか？", "korean": "어서 오세요. 뭘 찾으세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "人気の商品を教えてください。", "korean": "인기 상품을 알려주세요.", "correct": true},
          {"japanese": "日本のブランドを探しています。", "korean": "일본 브랜드를 찾고 있어요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "점원", "japanese": "こちらが一番人気です。試してみますか？", "korean": "이게 가장 인기 있어요. 사용해 보시겠어요?", "tip": "試してみる는 '사용해보다/시험해보다'를 의미합니다"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "はい、お願いします。", "korean": "네, 부탁합니다.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "점원", "japanese": "いかがですか？", "korean": "어떠세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "いいですね。これをください。", "korean": "좋네요. 이걸로 주세요.", "correct": true},
          {"japanese": "他の色はありますか？", "korean": "다른 색 있나요?", "correct": true}
        ]}
      ]
    },
    {
      "id": 3,
      "title": "면세 및 결제",
      "location": "계산대",
      "dialogues": [
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "免税で買えますか？", "korean": "면세로 살 수 있나요?", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "점원", "japanese": "はい、パスポートをお持ちですか？", "korean": "네, 여권 가지고 계세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "はい、こちらです。", "korean": "네, 여기요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "점원", "japanese": "プレゼント包装はいかがですか？", "korean": "선물 포장은 어떠세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "はい、お願いします。", "korean": "네, 부탁합니다.", "correct": true},
          {"japanese": "いいえ、大丈夫です。", "korean": "아니요, 괜찮습니다.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "점원", "japanese": "ありがとうございました。またお越しくださいませ。", "korean": "감사합니다. 또 오세요."}
      ]
    }
  ]
}

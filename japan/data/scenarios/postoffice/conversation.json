{
  "title": "우체국 회화",
  "scenes": [
    {
      "id": 1,
      "title": "엽서 보내기",
      "location": "우체국 창구",
      "dialogues": [
        {"speaker": "staff", "speakerName": "직원", "japanese": "いらっしゃいませ。", "korean": "어서 오세요."},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "韓国にはがきを送りたいのですが。", "korean": "한국에 엽서를 보내고 싶은데요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "韓国へのはがきは70円の切手が必要です。", "korean": "한국으로의 엽서는 70엔 우표가 필요합니다."},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "切手を5枚ください。", "korean": "우표 5장 주세요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "350円です。届くまで約1週間です。", "korean": "350엔입니다. 도착까지 약 1주일입니다.", "tip": "届く(とどく)는 '도착하다'를 의미합니다"}
      ]
    },
    {
      "id": 2,
      "title": "소포 발송",
      "location": "우체국 창구",
      "dialogues": [
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "この荷物を韓国に送りたいです。", "korean": "이 짐을 한국에 보내고 싶어요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "航空便と船便、どちらにしますか？", "korean": "항공편과 선편, 어느 쪽으로 하시겠어요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "航空便でお願いします。何日くらいで届きますか？", "korean": "항공편으로 부탁합니다. 며칠 정도면 도착하나요?", "correct": true},
          {"japanese": "船便は何日かかりますか？", "korean": "선편은 며칠 걸리나요?", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "航空便は約1週間、船便は1～2ヶ月です。", "korean": "항공편은 약 1주일, 선편은 1~2개월입니다."},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "送料はいくらですか？", "korean": "배송료는 얼마예요?", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "重さを測りますね。2キロで2,400円です。", "korean": "무게를 재볼게요. 2kg에 2,400엔입니다."}
      ]
    },
    {
      "id": 3,
      "title": "EMS 발송",
      "location": "우체국 창구",
      "dialogues": [
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "EMSで急いで送りたいのですが。", "korean": "EMS로 급히 보내고 싶은데요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "かしこまりました。中身は何ですか？", "korean": "알겠습니다. 내용물이 뭔가요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "お菓子と化粧品です。", "korean": "과자와 화장품입니다.", "correct": true},
          {"japanese": "洋服と雑貨です。", "korean": "옷과 잡화입니다.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "こちらの伝票に記入をお願いします。保険はつけますか？", "korean": "이 송장에 기입 부탁드립니다. 보험은 붙이시겠어요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "はい、お願いします。追跡番号はもらえますか？", "korean": "네, 부탁합니다. 추적번호는 받을 수 있나요?", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "はい、こちらの控えに追跡番号が記載されています。", "korean": "네, 이 영수증에 추적번호가 기재되어 있습니다."}
      ]
    }
  ]
}

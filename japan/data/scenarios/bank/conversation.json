{
  "title": "은행/환전 회화",
  "scenes": [
    {
      "id": 1,
      "title": "환전 요청",
      "location": "은행 창구",
      "dialogues": [
        {"speaker": "staff", "speakerName": "직원", "japanese": "いらっしゃいませ。今日はどのようなご用件ですか？", "korean": "어서 오세요. 오늘 어떤 용건이세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "ドルを円に両替したいのですが。", "korean": "달러를 엔으로 환전하고 싶은데요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "かしこまりました。いくら両替されますか？", "korean": "알겠습니다. 얼마를 환전하시겠어요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "500ドルお願いします。", "korean": "500달러 부탁합니다.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "今日のレートですと、約55,000円になります。手数料は500円です。", "korean": "오늘 환율로 약 55,000엔이 됩니다. 수수료는 500엔입니다.", "tip": "레ートは 환율을 의미합니다"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "はい、お願いします。", "korean": "네, 부탁합니다.", "correct": true}
        ]}
      ]
    },
    {
      "id": 2,
      "title": "ATM 이용",
      "location": "ATM 코너",
      "dialogues": [
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "すみません、ATMの使い方を教えてください。", "korean": "저기요, ATM 사용법을 알려주세요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "もちろんです。まずカードを入れてください。", "korean": "물론이죠. 먼저 카드를 넣어주세요."},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "暗証番号は4桁ですか？", "korean": "비밀번호는 4자리인가요?", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "はい、4桁の暗証番号を入力してください。", "korean": "네, 4자리 비밀번호를 입력해주세요."},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "引き出しは「出金」を押せばいいですか？", "korean": "출금은 '出金'을 누르면 되나요?", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "はい、そうです。金額を入力してください。", "korean": "네, 맞습니다. 금액을 입력해주세요."}
      ]
    },
    {
      "id": 3,
      "title": "계좌 개설",
      "location": "은행 창구",
      "dialogues": [
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "口座を開設したいのですが。", "korean": "계좌를 개설하고 싶은데요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "はい、在留カードと身分証明書をお持ちですか？", "korean": "네, 재류카드와 신분증 가지고 계세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "はい、こちらです。", "korean": "네, 여기요.", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "こちらの書類に記入をお願いします。印鑑はお持ちですか？", "korean": "이 서류에 기입 부탁드립니다. 도장 가지고 계세요?"},
        {"speaker": "player", "speakerName": "학습자", "choices": [
          {"japanese": "印鑑はありませんが、サインでも大丈夫ですか？", "korean": "도장이 없는데, 서명으로도 괜찮나요?", "correct": true}
        ]},
        {"speaker": "staff", "speakerName": "직원", "japanese": "はい、サインでも結構です。", "korean": "네, 서명으로도 괜찮습니다."}
      ]
    }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F5F5">

    <!-- 헤더 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UTTEC Lab NFC App V1.0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- 상태 표시 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="준비됨"
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/status_background"
        android:layout_marginBottom="24dp" />

    <!-- UID 쓰기 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etNewUid"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="새 UID (예: AA:BB:CC:DD)"
            android:textSize="14sp"
            android:inputType="textCapCharacters"
            android:fontFamily="monospace"
            android:background="@drawable/status_background"
            android:padding="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnWriteUid"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="UID 쓰기"
            android:textSize="14sp"
            android:backgroundTint="#E65100" />

    </LinearLayout>

    <!-- 버튼들 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnRead"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="태그 읽기"
            android:textSize="16sp"
            android:backgroundTint="#1976D2"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="지우기"
            android:textSize="16sp"
            android:backgroundTint="#757575"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- 태그 정보 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="태그 정보"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTagId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="태그 ID: -"
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvTagType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="태그 타입: -"
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="읽은 시간: -"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvTagData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="데이터: -"
                android:textSize="14sp"
                android:textColor="#444444"
                android:lineSpacingExtra="4dp" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>

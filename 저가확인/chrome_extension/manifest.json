{
  "manifest_version": 3,
  "name": "서울우유 저가 모니터링",
  "version": "1.1",
  "description": "쿠팡에서 서울우유 저가 판매 품목을 자동 검색합니다 (10분 자동 분석)",
  "permissions": [
    "activeTab",
    "scripting",
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.coupang.com/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.coupang.com/np/search*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

/*
 * UTTEC BLE Module — Modbus(HW UART) + LoRa SW-UART (TX, 2026-06-07 final)
 *
 *   HW UART0 (P0.15 TX / P0.02 RX, 9600 8N1) → MAX485 (RS485 Modbus) ★ 정확성 우선
 *   SPI1 MOSI (P0.11)  → SW-UART LoRa TX (9600) → E22 RXD
 *   SPI0 MOSI (P0.06)  → SW-UART USB-VCOM (9600) display
 *   SPI2 MOSI (P0.22)  → SW-UART Debug (115200)
 *
 *   J28 핀맵:
 *     Pin 1  P0.11  LoRa E22 RXD ← SPI1 MOSI (SW-UART)
 *     Pin 2  P0.15  MAX485 DI ← HW UART0 TX
 *     Pin 3  P0.13  (unused — TX만, LoRa RX 없음)
 *     Pin 4  P0.02  MAX485 RO → HW UART0 RX
 *     Pin 6  P0.17  LoRa M0 (Normal = LOW)
 *     Pin 7  P0.22  Debug TX (SPI2 MOSI)
 *     Pin 8  P0.19  LoRa M1 (Normal = LOW)
 *     Pin 9  P0.24  MAX485 DE/RE
 *     Pin 10 P0.20  LoRa AUX
 *     Pin 12 P0.04  Relay
 *
 *   E22 setup: 별도 (lora_test_tx 또는 lora_read_reg에서 1회 setup 후 유지).
 *   REG0=0x60 (9600 + 0.3k air), REG1=0x00 (max 30 dBm), REG2=0x48 (CH72).
 */

&pinctrl {
	/* UART0 default = LoRa (TX=P0.11, RX=P0.13) — main role.
	 * RS485 (P0.15/P0.02)는 PSEL runtime 변경으로 임시 사용. */
	uart0_default: uart0_default {
		group1 { psels = <NRF_PSEL(UART_TX, 0, 11)>; };
		group2 { psels = <NRF_PSEL(UART_RX, 0, 13)>; bias-pull-up; };
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 11)>, <NRF_PSEL(UART_RX, 0, 13)>;
			low-power-enable;
		};
	};

	/* SPI1 disabled — P0.11은 UART0 LoRa default가 사용 */

	/* SPI2 MOSI = Debug TX (P0.22, 115200). dummy SCK = P0.14. */
	spi2_default_alt: spi2_default_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 14)>, <NRF_PSEL(SPIM_MOSI, 0, 22)>;
			bias-pull-up;
		};
	};

	spi2_sleep_alt: spi2_sleep_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 14)>, <NRF_PSEL(SPIM_MOSI, 0, 22)>;
			low-power-enable; bias-pull-up;
		};
	};

	/* SPI0 MOSI = USB-VCOM TX (P0.06, 9600). dummy SCK = P0.16. */
	spi0_default_alt: spi0_default_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 16)>, <NRF_PSEL(SPIM_MOSI, 0, 6)>;
			bias-pull-up;
		};
	};

	spi0_sleep_alt: spi0_sleep_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 16)>, <NRF_PSEL(SPIM_MOSI, 0, 6)>;
			low-power-enable; bias-pull-up;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c0 { status = "disabled"; };
&i2c1 { status = "disabled"; };

&spi0 {
	status = "okay"; compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi0_default_alt>; pinctrl-1 = <&spi0_sleep_alt>;
	pinctrl-names = "default", "sleep";
};

&spi1 { status = "disabled"; };

&spi2 {
	status = "okay"; compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi2_default_alt>; pinctrl-1 = <&spi2_sleep_alt>;
	pinctrl-names = "default", "sleep";
};

/ {
	aliases {
		uttec-led-red = &uttec_led_red;
		uttec-led-blue = &uttec_led_blue;
		uttec-relay = &uttec_relay;
	};

	uttec_leds {
		compatible = "gpio-leds";
		uttec_led_red: led_red { gpios = <&gpio0 18 GPIO_ACTIVE_LOW>; label = "RED"; };
		uttec_led_blue: led_blue { gpios = <&gpio0 23 GPIO_ACTIVE_LOW>; label = "BLUE"; };
	};

	uttec_relays {
		compatible = "gpio-leds";
		uttec_relay: relay_0 { gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>; label = "Relay"; };
	};
};
